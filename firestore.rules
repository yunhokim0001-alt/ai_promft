rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'yunho.kim0001@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isValidPrompt(data) {
      return data.keys().hasAll(['title', 'category', 'content', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'content', 'createdAt'])
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 50
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 20000
        && data.createdAt is timestamp;
    }

    match /prompts/{promptId} {
      // Guests and admin can read prompts (no PII stored)
      allow get: if isValidId(promptId);
      allow list: if request.query.limit <= 200;

      // Only verified admin can create, update, or delete prompts
      allow create: if isAdmin()
        && isValidId(promptId)
        && isValidPrompt(incoming())
        && incoming().createdAt == request.time;

      allow update: if isAdmin()
        && isValidId(promptId)
        && isValidPrompt(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content']);

      allow delete: if isAdmin()
        && isValidId(promptId);
    }
  }
}
